# Flow's Table — Environment Variables
# Copy to .env and fill with real values

# Facebook Graph API — long-lived page access token
# Get from: https://developers.facebook.com/tools/explorer/
PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# Vercel deploy token (optional, for CI auto-deploy)
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token
